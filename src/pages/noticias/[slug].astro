---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/blog-post.css';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias');
  return noticias.map((noticia) => ({
    params: { slug: noticia.id },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;
const { Content } = await render(noticia);
const data = noticia.data;
const fecha = data.fecha.toLocaleDateString('es-AR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout
  title={data.titulo}
  description={data.descripcion}
  image={data.portada || '/social.jpg'}
  schema="article"
  canonical={'/noticias/' + noticia.id + '/'}
  publishedTime={data.fecha.toISOString()}
  author={data.autor || undefined}
  tags={data.tags}
>
  <article class="article-page">
    <a class="article-back" href="/noticias/">← Volver a Noticias</a>

    <header class="article-header">
      <p class="article-category">{data.categoria}</p>
      <h1>{data.titulo}</h1>
      {data.descripcion && <p class="article-deck">{data.descripcion}</p>}
      <div class="article-meta">
        <time datetime={data.fecha.toISOString()}>{fecha}</time>
        {data.autor && <span>Por {data.autor}</span>}
        <span>{Math.max(1, Math.ceil(String(noticia.body || '').split(/s+/).length / 220))} min de lectura</span>
      </div>
      {data.tags.length > 0 && (
        <div class="article-tags">
          {data.tags.map((tag) => <span>#{tag}</span>)}
        </div>
      )}
    </header>

    {data.portada && (
      <button
        class="article-hero-button"
        type="button"
        data-article-image={data.portada}
        data-article-alt={data.titulo}
        aria-label="Ampliar imagen de portada"
      >
        <img src={data.portada} alt={data.titulo} class="article-hero" />
      </button>
    )}

    <div class="article-content prose">
      <Content />
    </div>

    {data.imagenes.length > 0 && (
      <section class="article-gallery" aria-labelledby="gallery-title">
        <div>
          <p>Galería</p>
          <h2 id="gallery-title">Imágenes de la noticia</h2>
        </div>
        <div class="gallery-grid">
          {data.imagenes.map((image, index) => (
            <button
              type="button"
              data-article-image={image}
              data-article-alt={'Imagen ' + (index + 1) + ' de ' + data.titulo}
              aria-label={'Ampliar imagen ' + (index + 1)}
            >
              <img src={image} alt={'Imagen ' + (index + 1) + ' de ' + data.titulo} loading="lazy" />
            </button>
          ))}
        </div>
      </section>
    )}

    <footer class="article-footer">
      <p>Villars se informa mejor cuando las noticias tienen contexto y fuentes.</p>
      <a href="/noticias/">Ver todas las noticias</a>
    </footer>
  </article>

  <dialog id="article-image-dialog" class="article-image-dialog">
    <button type="button" data-dialog-close aria-label="Cerrar imagen">×</button>
    <img src="" alt="" />
  </dialog>

  <script>
    import '../../scripts/article-gallery.js';
  </script>
</Layout>
