---
import Layout from '../../layouts/Layout.astro';
import SocialEmbed from '../../components/SocialEmbed.astro';
import EventMap from '../../components/EventMap.astro';
import { getCollection, render } from 'astro:content';
import '../../styles/blog-post.css';

export async function getStaticPaths() {
  const noticias = await getCollection('noticias');
  return noticias.map((noticia) => ({
    params: { slug: noticia.id },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;
const { Content } = await render(noticia);
const data = noticia.data;
const wordCount = String(noticia.body || '').trim().split(/\s+/).filter(Boolean).length;
const fecha = data.fecha.toLocaleDateString('es-AR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const eventDate = data.fechaEvento?.toLocaleDateString('es-AR', {
  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
const eventEndDate = data.fechaFinEvento?.toLocaleDateString('es-AR', {
  weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC',
});
const eventDateKey = data.fechaEvento?.toISOString().slice(0, 10);
const eventEndDateKey = data.fechaFinEvento?.toISOString().slice(0, 10);
const eventStart = eventDateKey && data.horaEvento ? `${eventDateKey}T${data.horaEvento}:00-03:00` : eventDateKey;
const eventSchema = data.evento && eventStart ? {
  '@context': 'https://schema.org',
  '@type': 'Event',
  name: data.titulo,
  description: data.descripcion,
  startDate: eventStart,
  ...(eventEndDateKey ? { endDate: eventEndDateKey } : {}),
  eventStatus: 'https://schema.org/EventScheduled',
  url: new URL(`/noticias/${noticia.id}/`, Astro.site).href,
  ...(data.portada ? { image: [new URL(data.portada, Astro.site).href] } : {}),
  ...(data.lugarEvento || data.latEvento !== undefined ? {
    location: {
      '@type': 'Place',
      name: data.lugarEvento || 'Villars, Buenos Aires',
      ...(data.latEvento !== undefined && data.lonEvento !== undefined ? {
        geo: { '@type': 'GeoCoordinates', latitude: data.latEvento, longitude: data.lonEvento },
      } : {}),
    },
  } : {}),
} : null;
---

<Layout
  title={data.titulo}
  description={data.descripcion}
  image={data.portada || '/social.jpg'}
  schema="article"
  canonical={'/noticias/' + noticia.id + '/'}
  publishedTime={data.fecha.toISOString()}
  modifiedTime={data.modificada?.toISOString()}
  author={data.autor || undefined}
  tags={data.tags}
  section={data.categoria}
  wordCount={wordCount}
  breadcrumbs={[
    { name: 'Inicio', url: '/' },
    { name: 'Noticias', url: '/noticias/' },
    { name: data.titulo, url: `/noticias/${noticia.id}/` },
  ]}
>
  {eventSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(eventSchema)} />}
  <article class="article-page">
    <a class="article-back" href="/noticias/">← Volver a Noticias</a>

    <header class="article-header">
      <p class="article-category">{data.categoria}</p>
      <h1>{data.titulo}</h1>
      {data.descripcion && <p class="article-deck">{data.descripcion}</p>}
      <div class="article-meta">
        <time datetime={data.fecha.toISOString()}>{fecha}</time>
        {data.autor && <span>Por {data.autor}</span>}
        <span>{Math.max(1, Math.ceil(wordCount / 220))} min de lectura</span>
      </div>
      {data.tags.length > 0 && (
        <div class="article-tags">
          {data.tags.map((tag) => <span>#{tag}</span>)}
        </div>
      )}
    </header>

    {data.evento && data.fechaEvento && (
      <aside class="article-event-summary" aria-labelledby="event-summary-title">
        <div class="article-event-date" aria-hidden="true">
          <strong>{data.fechaEvento.toLocaleDateString('es-AR', { day: '2-digit', timeZone: 'UTC' })}</strong>
          <span>{data.fechaEvento.toLocaleDateString('es-AR', { month: 'short', timeZone: 'UTC' }).replace('.', '')}</span>
        </div>
        <div>
          <p>Evento</p>
          <h2 id="event-summary-title">{eventDate}</h2>
          {eventEndDate && eventEndDateKey !== eventDateKey && <span>Hasta el {eventEndDate}</span>}
          {(data.horaEvento || data.lugarEvento) && (
            <strong>{[data.horaEvento && `${data.horaEvento} h`, data.lugarEvento].filter(Boolean).join(' · ')}</strong>
          )}
        </div>
      </aside>
    )}

    {data.portada && (
      <button
        class="article-hero-button"
        type="button"
        data-article-image={data.portada}
        data-article-alt={data.titulo}
        aria-label="Ampliar imagen de portada"
      >
        <img src={data.portada} alt={data.titulo} class="article-hero" decoding="async" />
      </button>
    )}

    <div class="article-content prose">
      <Content components={{ SocialEmbed }} />
    </div>

    {data.evento && data.mostrarMapaEvento && data.latEvento !== undefined && data.lonEvento !== undefined && (
      <EventMap lat={data.latEvento} lon={data.lonEvento} place={data.lugarEvento || 'Ubicación del evento'} />
    )}

    {data.imagenes.length > 0 && (
      <section class="article-gallery" aria-labelledby="gallery-title">
        <div>
          <p>Galería</p>
          <h2 id="gallery-title">Imágenes de la noticia</h2>
        </div>
        <div class="gallery-grid">
          {data.imagenes.map((image, index) => (
            <button
              type="button"
              data-article-image={image}
              data-article-alt={'Imagen ' + (index + 1) + ' de ' + data.titulo}
              aria-label={'Ampliar imagen ' + (index + 1)}
            >
              <img src={image} alt={'Imagen ' + (index + 1) + ' de ' + data.titulo} loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      </section>
    )}

    <footer class="article-footer">
      <p>Villars se informa mejor cuando las noticias tienen contexto y fuentes.</p>
      <a href="/noticias/">Ver todas las noticias</a>
    </footer>
  </article>

  <dialog id="article-image-dialog" class="article-image-dialog">
    <button type="button" data-dialog-close aria-label="Cerrar imagen">×</button>
    <img src="" alt="" />
  </dialog>

  <script>
    import '../../scripts/article-gallery.js';
  </script>
</Layout>
