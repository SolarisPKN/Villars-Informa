---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import healthData from '../data/health-services.json';
import '../styles/health.css';

const actualizaciones = await getCollection('actualizaciones');
actualizaciones.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const updates = actualizaciones.slice(0, 5);
const formatDate = (date: Date) => date.toLocaleDateString('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Layout
  title="Salud en Villars"
  description="Avisos sanitarios, CAPS Villars, centros de salud y farmacias de referencia para la comunidad."
  canonical="/salud/"
>
  <div class="health-page">
    <header class="health-hero">
      <p class="health-kicker">Información comunitaria verificada</p>
      <h1>Salud en Villars</h1>
      <p>Avisos breves, contactos y lugares de atención reunidos en una sola página.</p>
      <p class="health-verified">Datos fijos revisados el <time datetime={healthData.verifiedAt}>{formatDate(new Date(healthData.verifiedAt + 'T12:00:00'))}</time>.</p>
    </header>

    <section class="health-section updates-section" aria-labelledby="updates-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Al día</p>
          <h2 id="updates-title">Últimas noticias de Salud</h2>
        </div>
        <span class="section-limit">Máximo 5 avisos</span>
      </div>

      <div class="health-feed">
        {updates.length === 0 ? (
          <div class="health-empty">
            <span aria-hidden="true">✦</span>
            <p>Todavía no se publicaron avisos sanitarios.</p>
          </div>
        ) : updates.map((update) => (
          <article class="health-update">
            <header>
              <span class="update-avatar" aria-hidden="true">+</span>
              <div>
                <h3>{update.data.titulo}</h3>
                <time datetime={update.data.fecha.toISOString()}>{formatDate(update.data.fecha)}</time>
              </div>
            </header>
            <p class="update-message">{update.data.mensaje}</p>
            {update.data.imagen && (
              <button
                class="update-image-button"
                type="button"
                data-health-image={update.data.imagen}
                data-health-alt={'Imagen adjunta de ' + update.data.titulo}
                aria-label={'Ampliar imagen de ' + update.data.titulo}
              >
                <img src={update.data.imagen} alt="" loading="lazy" />
              </button>
            )}
            {(update.data.fuente || update.data.fuenteUrl) && (
              <footer>
                <span>Fuente:</span>
                {update.data.fuenteUrl ? (
                  <a href={update.data.fuenteUrl} target="_blank" rel="noopener noreferrer">
                    {update.data.fuente || 'Ver publicación original'}
                  </a>
                ) : (
                  <span>{update.data.fuente}</span>
                )}
              </footer>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="health-section" aria-labelledby="villars-care-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">A mano</p>
          <h2 id="villars-care-title">Atención y farmacia</h2>
        </div>
      </div>

      <div class="primary-services">
        {healthData.primaryServices.map((service) => (
          <article class:list={['service-card', service.kind === 'Salita' && 'service-card-primary']}>
            <p class="service-kind">{service.kind}</p>
            <h3>{service.name}</h3>
            <dl>
              <div><dt>Dirección</dt><dd>{service.address}</dd></div>
              <div><dt>Horario</dt><dd>{service.hours}</dd></div>
              <div>
                <dt>Teléfono</dt>
                <dd>
                  {service.phoneHref ? <a href={service.phoneHref}>{service.phone}</a> : 'Sin teléfono local publicado'}
                  {service.phoneLabel && <small>{service.phoneLabel}</small>}
                </dd>
              </div>
            </dl>
            {service.target && <a class="card-action" href={service.target}>{service.status} ↓</a>}
            {!service.target && <span class="status-chip">{service.status}</span>}
          </article>
        ))}
      </div>

      <details class="more-centers">
        <summary>
          <span>Mostrar otros centros de salud</span>
          <small>Hospital, CAPS y Salud Comunitaria</small>
        </summary>
        <div class="center-grid">
          {healthData.otherCenters.map((center) => (
            <article class="center-card">
              <p>{center.locality}</p>
              <h3>{center.name}</h3>
              <address>{center.address}</address>
              <p>{center.hours}</p>
              {center.phoneHref ? (
                <a class="phone-link" href={center.phoneHref}>Llamar al {center.phone}</a>
              ) : (
                <span class="missing-contact">Teléfono no publicado en la fuente</span>
              )}
            </article>
          ))}
        </div>
      </details>
    </section>

    <section id="farmacias" class="health-section pharmacies-section" aria-labelledby="pharmacies-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Antes de viajar</p>
          <h2 id="pharmacies-title">Farmacias de turno</h2>
        </div>
      </div>

      <div class="pharmacy-layout">
        <div class="pharmacy-selector">
          <label for="pharmacy-select">Elegí una farmacia del directorio</label>
          <select id="pharmacy-select">
            {healthData.pharmacies.map((pharmacy, index) => (
              <option value={index}>{pharmacy.name}</option>
            ))}
          </select>
          <p class="turn-warning">
            El municipio no publica en la página consultada un cronograma vigente de guardias.
            Confirmá por teléfono qué farmacia está de turno antes de salir.
          </p>
        </div>
        <div class="pharmacy-results" aria-live="polite">
          {healthData.pharmacies.map((pharmacy, index) => (
            <article class="pharmacy-card" data-pharmacy-card={index} hidden={index !== 0}>
              <p class="service-kind">General Las Heras</p>
              <h3>{pharmacy.name}</h3>
              <address>{pharmacy.address}</address>
              <a class="phone-link" href={pharmacy.phoneHref}>Llamar al {pharmacy.phone}</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="health-section emergency-section" aria-labelledby="emergency-title">
      <div>
        <p class="section-kicker">Urgencias</p>
        <h2 id="emergency-title">Si necesitás ayuda inmediata</h2>
        <p>Esta página es informativa y no reemplaza la atención profesional.</p>
      </div>
      <div class="emergency-actions">
        <a href="tel:107"><span>SAME</span><strong>107</strong></a>
        <a href="tel:911"><span>Emergencias</span><strong>911</strong></a>
        <a href="tel:+542204761000"><span>Hospital Arozarena</span><strong>0220 476-1000</strong></a>
      </div>
    </section>

    <details class="sources-panel">
      <summary>Fuentes y vigencia de los datos</summary>
      <p>Los horarios pueden cambiar. La fecha de cada fuente se muestra para que puedas evaluar su vigencia y confirmar antes de trasladarte.</p>
      <ul>
        {healthData.sources.map((source) => (
          <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.label}</a></li>
        ))}
      </ul>
    </details>
  </div>

  <dialog id="health-image-dialog" class="image-dialog">
    <button type="button" data-dialog-close aria-label="Cerrar imagen">×</button>
    <img src="" alt="" />
  </dialog>

  <script>
    import '../scripts/health.js';
  </script>
</Layout>
