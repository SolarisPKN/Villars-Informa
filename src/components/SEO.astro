---
export interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  schema?: 'website' | 'article' | 'localBusiness';
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  business?: Record<string, unknown>;
}

const {
  title,
  description,
  image = '/social.jpg',
  canonical = Astro.url.pathname,
  schema = 'website',
  publishedTime,
  modifiedTime,
  author = 'Villars Informa',
  tags = [],
  business,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://villars.solarispkn.com.ar';
const fullUrl = new URL(canonical, `${siteUrl}/`).toString();
const fullImage = image.startsWith('http') ? image : new URL(image, `${siteUrl}/`).toString();
const documentTitle = title.toLowerCase().includes('villars informa') ? title : `${title} | Villars Informa`;
const isNotFound = Astro.url.pathname === '/404' || Astro.url.pathname === '/404.html';
const robots = isNotFound ? 'noindex,nofollow' : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
const organization = {
  '@type': 'Organization', '@id': `${siteUrl}/#organization`, name: 'Villars Informa', url: siteUrl,
  logo: { '@type': 'ImageObject', url: new URL('/icon-512.png', `${siteUrl}/`).toString() },
};
const webSite = {
  '@type': 'WebSite', '@id': `${siteUrl}/#website`, name: 'Villars Informa', url: siteUrl,
  description, inLanguage: 'es-AR', publisher: { '@id': `${siteUrl}/#organization` },
};
let pageSchema: Record<string, unknown> = {
  '@type': 'WebPage', '@id': `${fullUrl}#webpage`, url: fullUrl, name: documentTitle, description,
  inLanguage: 'es-AR', isPartOf: { '@id': `${siteUrl}/#website` },
};
if (schema === 'article') {
  pageSchema = {
    '@type': 'Article', '@id': `${fullUrl}#article`, headline: title, description,
    mainEntityOfPage: { '@id': `${fullUrl}#webpage` }, author: { '@type': 'Person', name: author },
    publisher: { '@id': `${siteUrl}/#organization` }, datePublished: publishedTime,
    dateModified: modifiedTime || publishedTime, image: fullImage, keywords: tags.join(', '), inLanguage: 'es-AR',
  };
} else if (schema === 'localBusiness' && business) {
  const name = typeof business.nombre === 'string' ? business.nombre : title;
  const address = typeof business.direccion === 'string' ? business.direccion : undefined;
  const telephone = typeof business.telefono === 'string' ? business.telefono : undefined;
  const openingHours = typeof business.horarios === 'string' ? business.horarios : undefined;
  pageSchema = {
    '@type': 'LocalBusiness', '@id': `${fullUrl}#business`, name, url: fullUrl, description, image: fullImage,
    telephone, openingHours,
    address: address ? { '@type': 'PostalAddress', streetAddress: address, addressLocality: 'Villars', addressRegion: 'Buenos Aires', addressCountry: 'AR' } : undefined,
  };
}
const jsonLd = { '@context': 'https://schema.org', '@graph': [organization, webSite, pageSchema] };
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<meta name="robots" content={robots} />
<meta name="generator" content={Astro.generator} />
<meta name="author" content={author} />
<meta name="theme-color" content="#1a1410" />
<meta name="color-scheme" content="dark" />
<meta name="referrer" content="strict-origin-when-cross-origin" />
<title>{documentTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={fullUrl} />
<meta property="og:title" content={documentTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImage} />
<meta property="og:image:alt" content={title} />
<meta property="og:url" content={fullUrl} />
<meta property="og:type" content={schema === 'article' ? 'article' : 'website'} />
<meta property="og:locale" content="es_AR" />
<meta property="og:site_name" content="Villars Informa" />
{schema === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={documentTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImage} />
<meta name="twitter:image:alt" content={title} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
<link rel="apple-touch-icon" href="/icon-192.png" />
<link rel="manifest" href="/manifest.webmanifest" />
<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
