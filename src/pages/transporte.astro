---
import Layout from '../layouts/Layout.astro';
import transportData from '../data/transport-schedules.json';
import { destinationsFrom, directionsFor, formatMinutes, nextServiceForRoute, stationScheduleGrid, weekdayNames } from '../utils/transport-services.js';

const villarsRoutes = transportData.routes.filter((route) => destinationsFrom(route).length > 0);
const scheduleDays = [
  { key: 'weekday', label: 'Lunes a viernes' },
  { key: 'saturday', label: 'Sábados' },
  { key: 'sunday', label: 'Domingos' },
];
const initialRoute = villarsRoutes[0];
const initialNext = initialRoute ? nextServiceForRoute(initialRoute, transportData.timezone) : null;
const initialDirections = initialRoute ? directionsFor(initialRoute) : [];
const initialDirection = initialDirections[0]?.key;
const initialScheduleGrids = initialRoute
  ? scheduleDays.map((day) => {
      const grid = stationScheduleGrid(initialRoute, day.key, initialDirection);
      return {
        ...day,
        grid,
      };
    })
  : [];
const updatedAt = transportData.source.updatedAt
  ? new Date(transportData.source.updatedAt).toLocaleString('es-AR', { timeZone: transportData.timezone, dateStyle: 'long', timeStyle: 'short' })
  : 'sin fecha informada';
---

<Layout title="Transporte en Villars" description="Horarios programados de colectivos y trenes con parada en Villars, obtenidos de SolarisPKN Transport." canonical="/transporte/">
  <section class="transport-page" data-transport-app>
    <header class="transport-hero">
      <p class="eyebrow">Horarios versionados · posiciones cada minuto</p>
      <h1>Transporte en Villars</h1>
      <p>Consultá las salidas programadas de colectivos y trenes que realmente continúan desde Villars hasta el destino elegido. El mapa funciona con cartografía alojada en este mismo sitio.</p>
    </header>
    {villarsRoutes.length === 0 ? (
      <div class="transport-panel"><h2>Datos temporalmente no disponibles</h2><p>El snapshot actual no contiene recorridos con parada en Villars.</p></div>
    ) : (
      <div class="transport-panel">
        <div class="service-picker">
          <div>
            <p class="eyebrow">Elegí el servicio</p>
            <p>Al cambiar de servicio se actualizan juntas las tres grillas.</p>
          </div>
          <div class="service-tabs" role="tablist" aria-label="Servicio de transporte">
            {villarsRoutes.map((route, index) => (
              <button
                type="button"
                role="tab"
                data-service-tab={route.id}
                aria-selected={index === 0 ? 'true' : 'false'}
                aria-controls="transport-schedule-panel"
                tabindex={index === 0 ? 0 : -1}
              >
                <span aria-hidden="true">{route.type === 'bus' ? '🚌' : '🚆'}</span>
                <strong>{route.type === 'bus' ? 'Línea 322' : 'Belgrano Sur'}</strong>
                <small>{route.name}</small>
              </button>
            ))}
          </div>
        </div>
        <div class="next-service" aria-live="polite">
          <span class="next-label">Próximo servicio programado por Villars</span>
          <strong data-next-service>{initialNext ? weekdayNames[initialNext.weekday] + ' ' + initialNext.date + ' · ' + formatMinutes(initialNext.minutes).value : 'Sin servicio'}</strong>
          <span data-next-detail>{initialNext ? 'Hacia ' + initialNext.destination : 'No se encontraron salidas en los próximos siete días.'}</span>
        </div>
        <div class="schedule-heading">
          <div><p class="eyebrow" data-route-type>{initialRoute?.type === 'bus' ? 'Colectivo' : 'Tren'}</p><h2 data-schedule-title>Todos los horarios de {initialRoute?.branch || initialRoute?.name}</h2></div>
          <p data-validity>{initialRoute?.validFrom ? 'Vigencia informada desde ' + new Date(initialRoute.validFrom + 'T12:00:00').toLocaleDateString('es-AR') : 'Sin vigencia informada'}</p>
        </div>
        <div class="direction-picker">
          <label for="transport-direction">Sentido del recorrido</label>
          <div class="direction-select-wrap">
            <select id="transport-direction" data-direction-select aria-controls="transport-schedule-panel">
              {initialDirections.map(({ key, label }) => <option value={key}>{label}</option>)}
            </select>
            <span aria-hidden="true">↓</span>
          </div>
          <p>Cada columna es una formación. El destino debajo del número indica dónde termina realmente.</p>
        </div>
        <div id="transport-schedule-panel" class="schedule-sections" data-schedule-sections role="tabpanel" tabindex="0" aria-live="polite">
          {initialScheduleGrids.map(({ key, label, grid }) => (
            <section class="schedule-block" data-schedule-day={key}>
              <div class="schedule-block-heading"><h3>{label}</h3><span>{grid.services.length ? grid.services.length + ' formaciones' : 'Sin servicios'}</span></div>
              <div class="schedule-table-scroll">
                <table class="schedule-table">
                  <caption>{initialRoute?.branch || initialRoute?.name} · {label} · Hacia {initialDirection}</caption>
                  <thead><tr><th scope="col" class="station-column">Estación</th>{grid.services.map((service) => <th scope="col"><span>{service.name}</span><small>hasta {service.destination}</small></th>)}</tr></thead>
                  <tbody>
                    {grid.stations.map((station) => (
                      <tr class:list={{ 'villars-row': station.normalizedName === 'villars' }}>
                        <th scope="row" class="station-column"><span>{station.name}</span>{station.normalizedName === 'villars' && <small>Estás acá</small>}</th>
                        {station.stops.map((stop: { minutes: number } | null) => stop ? (
                          <td><span>{formatMinutes(stop.minutes).value}</span>{formatMinutes(stop.minutes).nextDay && <small>+1 día</small>}</td>
                        ) : <td class="empty-time">—</td>)}
                      </tr>
                    ))}
                    {grid.stations.length === 0 && <tr><td colspan={Math.max(1, grid.services.length + 1)} class="no-services">No hay servicios informados para este día y sentido.</td></tr>}
                  </tbody>
                </table>
              </div>
            </section>
          ))}
        </div>
        <div class="route-meta">
          <p><strong>Operador:</strong> <span data-company>{initialRoute?.company || 'No informado'}</span></p>
          <p><strong>Método de actualización:</strong> <span data-update-method>{initialRoute?.schedules[0]?.updateMethod || 'No informado'}</span></p>
          <p><a data-operator-link href={initialRoute?.websiteUrl || initialRoute?.sourceUrl || transportData.source.repository} target="_blank" rel="noopener noreferrer">Consultar fuente del operador</a></p>
        </div>
      </div>
    )}
    <section class="map-panel" aria-labelledby="transport-map-title">
      <div class="map-heading">
        <div><p class="eyebrow">Mapa regional autocontenido</p><h2 id="transport-map-title">Trenes y colectivos alrededor de Villars</h2></div>
        <p data-live-map-status data-state="static" aria-live="polite">Cargando la cartografía local…</p>
      </div>
      <div class="map-layout">
        <div class="map-stage">
          <div class="transport-map" data-transport-map aria-label="Mapa navegable de los recorridos de transporte en Villars"></div>
        </div>
        <aside class="map-filters" aria-label="Filtros del mapa">
          <div class="filter-heading"><p class="eyebrow">Capas visibles</p><h3>Filtrar mapa</h3></div>
          <fieldset>
            <legend>Transporte</legend>
            <label><input type="checkbox" data-map-mode="train" checked /> <span><i class="train"></i> Trenes</span></label>
            <label><input type="checkbox" data-map-mode="bus" checked /> <span><i class="bus"></i> Colectivos</span></label>
          </fieldset>
          <fieldset>
            <legend>Recorridos</legend>
            <label><input type="checkbox" data-map-route="train" checked /> <span>Catán–Lozano</span></label>
            <label><input type="checkbox" data-map-route="322" checked /> <span>Línea 322</span></label>
            <label class="unavailable"><input type="checkbox" data-map-route="136" disabled /> <span>Línea 136 <small>sin trazado local</small></span></label>
          </fieldset>
          <fieldset>
            <legend>Mostrar</legend>
            <label><input type="checkbox" data-map-layer="positions" checked /> <span><i class="live"></i> Ubicaciones</span></label>
            <label><input type="checkbox" data-map-layer="routes" checked /> <span>Recorridos</span></label>
            <label><input type="checkbox" data-map-layer="stops" checked /> <span>Estaciones y paradas</span></label>
          </fieldset>
          <div class="position-key"><span><i class="live"></i> GPS informado</span><span><i class="estimated"></i> Estimación por horario</span></div>
        </aside>
      </div>
      <p class="map-note">La cartografía PMTiles está alojada en el sitio. Los filtros actúan sólo sobre la visualización: no alteran el snapshot ni los horarios. La línea 136 permanecerá desactivada hasta contar con una geometría verificable para no dibujar un recorrido aproximado como si fuera real.</p>
    </section>
    <aside class="data-note">
      <h2>Sobre estos datos</h2>
      <p>Snapshot actualizado el <strong>{updatedAt}</strong>. La copia SQLite y el JSON derivado quedan versionados para poder auditar cada cambio.</p>
      <p>Fuente: <a href={transportData.source.repository}>SolarisPKN Transport</a>. Hash del snapshot: <code>{transportData.source.databaseSha256.slice(0, 12)}…</code></p>
      <p>Posiciones ferroviarias: <a href="https://www.argentina.gob.ar/transporte/trenes-argentinos/app" target="_blank" rel="noopener noreferrer">Trenes Argentinos</a>. La atribución se realiza conforme a sus <a href="https://www.argentina.gob.ar/transporte/trenes-argentinos/terminos-y-condiciones" target="_blank" rel="noopener noreferrer">términos de contenido CC BY 4.0</a>.</p>
    </aside>
  </section>
  {villarsRoutes.length > 0 && <script>import '../scripts/transport.js'; import '../scripts/transport-map.js';</script>}
</Layout>

<style>
  .transport-page { width: min(1240px, calc(100% - 2rem)); margin: 3rem auto; }
  .transport-hero { max-width: 800px; margin-bottom: 2rem; }
  .transport-hero h1 { margin: .25rem 0 1rem; color: var(--accent-mustard); font-family: Georgia, serif; font-size: clamp(2.3rem, 7vw, 4.5rem); }
  .transport-hero > p:last-child { color: var(--text-muted); font-size: 1.08rem; }
  .eyebrow { margin: 0; color: var(--accent-olive); font-family: 'JetBrains Mono', monospace; font-size: .78rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .transport-panel, .data-note, .map-panel { padding: clamp(1rem, 3vw, 2rem); border: 1px solid rgba(212,163,115,.35); border-radius: 1.5rem; background: rgba(44,33,25,.82); box-shadow: 0 20px 60px rgba(0,0,0,.25); }
  .service-picker { display: grid; grid-template-columns: minmax(13rem,.65fr) minmax(0,1.35fr); gap: 1.25rem; align-items: center; }
  .service-picker > div:first-child > p:last-child { margin: .4rem 0 0; color: var(--text-muted); font-size: .86rem; }
  .service-tabs { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: .75rem; }
  .service-tabs button { display: grid; grid-template-columns: auto 1fr; gap: .1rem .65rem; align-items: center; padding: .85rem 1rem; border: 1px solid rgba(212,163,115,.35); border-radius: .9rem; color: var(--text-light); background: rgba(26,20,16,.7); text-align: left; cursor: pointer; transition: border-color .2s, background .2s, transform .2s; }
  .service-tabs button > span { grid-row: 1 / span 2; font-size: 1.4rem; }.service-tabs button strong { font-size: .95rem; }.service-tabs button small { color: var(--text-muted); }
  .service-tabs button[aria-selected='true'] { border-color: var(--accent-mustard); background: rgba(233,196,106,.13); box-shadow: inset 0 0 0 1px rgba(233,196,106,.2); }.service-tabs button:hover { transform: translateY(-1px); }
  .next-service { display: grid; grid-template-columns: 1fr auto; gap: .15rem 1rem; align-items: center; margin: 1.5rem 0; padding: 1rem 1.15rem; border-left: 4px solid var(--accent-olive); border-radius: .8rem; background: rgba(163,177,138,.1); }
  .next-service strong { grid-column: 2; grid-row: 1 / span 2; color: var(--accent-mustard); font-size: clamp(1.25rem,3vw,2rem); }.next-service > span:last-child { color: var(--text-muted); font-size: .9rem; }
  .schedule-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: end; margin-top: 2rem; }.schedule-heading h2 { margin: .25rem 0 0; }.schedule-heading > p { color: var(--text-muted); font-size: .85rem; text-align: right; }
  .direction-picker { display: grid; grid-template-columns: auto minmax(15rem,22rem) 1fr; gap: .7rem 1rem; align-items: center; margin-top: 1.1rem; padding: .9rem 1rem; border: 1px solid rgba(163,177,138,.3); border-radius: 1rem; background: linear-gradient(110deg,rgba(163,177,138,.13),rgba(233,196,106,.05)); }
  .direction-picker > label { color: var(--text-light); font-size: .82rem; font-weight: 750; letter-spacing: .03em; text-transform: uppercase; }.direction-picker > p { margin: 0; color: var(--text-muted); font-size: .78rem; }
  .direction-select-wrap { position: relative; }.direction-select-wrap select { width: 100%; padding: .72rem 2.5rem .72rem .85rem; border: 1px solid rgba(233,196,106,.55); border-radius: .7rem; color: var(--text-light); background: #241a14; font: 700 .9rem Inter,sans-serif; appearance: none; cursor: pointer; }.direction-select-wrap > span { position: absolute; top: 50%; right: .85rem; color: var(--accent-mustard); pointer-events: none; transform: translateY(-50%); }
  .schedule-sections { display: grid; gap: 1.25rem; margin-top: 1rem; }
  :global(.schedule-block) { overflow: hidden; border: 1px solid rgba(233,196,106,.3); border-radius: 1rem; background: rgba(26,20,16,.58); box-shadow: 0 10px 28px rgba(0,0,0,.16); }
  :global(.schedule-block:nth-child(2)) { border-color: rgba(163,177,138,.38); }:global(.schedule-block:nth-child(3)) { border-color: rgba(231,111,81,.32); }
  :global(.schedule-block-heading) { display: flex; justify-content: space-between; gap: 1rem; align-items: center; padding: .85rem 1rem; border-bottom: 1px solid rgba(233,196,106,.2); background: linear-gradient(90deg,rgba(233,196,106,.14),rgba(233,196,106,.02)); }
  :global(.schedule-block:nth-child(2) .schedule-block-heading) { background: linear-gradient(90deg,rgba(163,177,138,.15),transparent); }:global(.schedule-block:nth-child(3) .schedule-block-heading) { background: linear-gradient(90deg,rgba(231,111,81,.12),transparent); }
  :global(.schedule-block-heading h3) { margin: 0; color: var(--accent-mustard); font-size: 1.08rem; }:global(.schedule-block-heading span) { padding: .25rem .55rem; border-radius: 999px; color: var(--text-muted); background: rgba(0,0,0,.2); font-size: .72rem; }
  :global(.schedule-table-scroll) { max-height: 31rem; overflow: auto; scrollbar-color: rgba(233,196,106,.45) rgba(0,0,0,.12); }:global(.schedule-table) { width: 100%; min-width: max(100%,48rem); border-collapse: separate; border-spacing: 0; font-family: 'JetBrains Mono',monospace; font-variant-numeric: tabular-nums; }
  :global(.schedule-table caption) { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  :global(.schedule-table th), :global(.schedule-table td) { min-width: 6.35rem; padding: .75rem .8rem; border-right: 1px solid rgba(212,163,115,.14); border-bottom: 1px solid rgba(212,163,115,.13); text-align: center; }
  :global(.schedule-table thead th) { position: sticky; top: 0; z-index: 3; color: var(--text-light); background: #30261e; box-shadow: 0 2px 0 rgba(233,196,106,.22); font-family: Inter,sans-serif; font-size: .85rem; }:global(.schedule-table thead th > span) { display: block; color: var(--accent-mustard); font-family: 'JetBrains Mono',monospace; font-size: .92rem; }:global(.schedule-table thead th > small) { display: block; max-width: 8rem; margin: .15rem auto 0; color: var(--text-muted); font-size: .63rem; font-weight: 500; line-height: 1.2; }
  :global(.schedule-table .station-column) { position: sticky; left: 0; z-index: 2; width: 10.5rem; min-width: 10.5rem; max-width: 10.5rem; text-align: left; }:global(.schedule-table thead .station-column) { z-index: 4; background: #3a2b20; }
  :global(.schedule-table tbody .station-column) { color: var(--text-light); background: #261d17; font-family: Inter,sans-serif; font-size: .8rem; font-weight: 720; }:global(.schedule-table tbody .station-column small) { display: block; margin-top: .18rem; color: var(--accent-mustard); font-size: .62rem; text-transform: uppercase; }
  :global(.schedule-table tbody tr:nth-child(even) td) { background: rgba(255,255,255,.025); }:global(.schedule-table tbody tr:hover td) { background: rgba(233,196,106,.08); }
  :global(.schedule-table tbody .villars-row td) { background: rgba(233,196,106,.12); }:global(.schedule-table tbody .villars-row .station-column) { color: #1d1712; background: var(--accent-mustard); }:global(.schedule-table tbody .villars-row .station-column small) { color: #5f4528; }
  :global(.schedule-table td) { color: var(--text-light); font-size: .98rem; }:global(.schedule-table td small) { display: block; color: var(--accent-terracotta); font-family: Inter,sans-serif; font-size: .62rem; }:global(.schedule-table .empty-time) { color: rgba(255,255,255,.22); background-image: linear-gradient(135deg,transparent 49%,rgba(255,255,255,.04) 50%,transparent 51%); }:global(.schedule-table .no-services) { padding: 1.4rem; color: var(--text-muted); font-family: Inter,sans-serif; text-align: left; }
  .route-meta { display: flex; gap: .75rem 1.5rem; flex-wrap: wrap; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid rgba(212,163,115,.2); color: var(--text-muted); font-size: .85rem; }.route-meta p { margin: 0; }
  .data-note { margin-top: 1.25rem; background: rgba(44,33,25,.5); }.data-note h2 { font-size: 1.15rem; }.data-note p { margin: .4rem 0; color: var(--text-muted); font-size: .9rem; }.data-note code { word-break: break-all; }
  .map-panel { margin-top: 1.25rem; }.map-heading { display: flex; justify-content: space-between; align-items: end; gap: 1.5rem; }.map-heading h2 { margin: .25rem 0 0; }.map-heading > p { max-width: 32rem; margin: 0; color: var(--text-muted); font-size: .85rem; text-align: right; }.map-heading > p[data-state='live'] { color: #9ed7b0; }.map-heading > p[data-state='error'] { color: #f4a261; }
  .map-layout { display: grid; grid-template-columns: minmax(0,1fr) 17.5rem; gap: 1rem; align-items: stretch; margin-top: 1rem; }.map-stage { min-width: 0; }.transport-map { min-height: 34rem; height: 100%; overflow: hidden; border: 1px solid rgba(233,196,106,.25); border-radius: 1rem; background: #17110d; }
  .map-filters { padding: 1rem; border: 1px solid rgba(212,163,115,.25); border-radius: 1rem; background: rgba(26,20,16,.7); }.filter-heading h3 { margin: .2rem 0 .9rem; }.map-filters fieldset { display: grid; gap: .58rem; margin: 0; padding: .85rem 0; border: 0; border-top: 1px solid rgba(212,163,115,.18); }.map-filters legend { padding: .85rem 0 .25rem; color: var(--text-light); font-size: .78rem; font-weight: 750; text-transform: uppercase; letter-spacing: .05em; }
  .map-filters label { display: flex; gap: .55rem; align-items: start; color: var(--text-muted); font-size: .82rem; cursor: pointer; }.map-filters input { margin-top: .13rem; accent-color: var(--accent-mustard); }.map-filters label > span { display: inline-flex; gap: .4rem; align-items: center; }.map-filters label small { display: block; color: rgba(255,255,255,.38); font-size: .65rem; }.map-filters .unavailable { cursor: not-allowed; opacity: .65; }
  .map-filters i, .position-key i { display: inline-block; width: .72rem; height: .72rem; border-radius: 999px; background: #e9c46a; }.map-filters i.bus { background: #6fb7ff; }.map-filters i.live, .position-key i.live { border: 2px solid white; background: #219ebc; }.position-key i.estimated { border: 2px dashed white; background: #ffb703; }
  .position-key { display: grid; gap: .45rem; padding-top: .85rem; border-top: 1px solid rgba(212,163,115,.18); color: var(--text-muted); font-size: .72rem; }.position-key span { display: flex; gap: .45rem; align-items: center; }
  .map-note { margin: .8rem 0 0; color: var(--text-muted); font-size: .8rem; }:global(.leaflet-container) { color: #241a14; font-family: Inter, sans-serif; }:global(.leaflet-popup-content-wrapper) { border-radius: .65rem; }:global(.leaflet-control-attribution) { font-size: .65rem; }
  @media (max-width: 900px) { .service-picker { grid-template-columns: 1fr; }.direction-picker { grid-template-columns: auto minmax(14rem,1fr); }.direction-picker > p { grid-column: 1 / -1; }.map-layout { grid-template-columns: 1fr; }.map-filters { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 0 1rem; }.filter-heading, .position-key { grid-column: 1 / -1; }.map-filters fieldset { border-top: 0; }.transport-map { min-height: 29rem; } }
  @media (max-width: 640px) { .transport-page { width: min(100% - 1rem, 1240px); margin-top: 1.5rem; }.service-tabs { grid-template-columns: 1fr; }.next-service { grid-template-columns: 1fr; }.next-service strong { grid-column: 1; grid-row: auto; }.schedule-heading, .map-heading { align-items: start; flex-direction: column; }.schedule-heading > p, .map-heading > p { text-align: left; }.direction-picker { grid-template-columns: 1fr; }.direction-picker > p { grid-column: auto; }.map-filters { grid-template-columns: 1fr; }.filter-heading, .position-key { grid-column: auto; }.transport-map { min-height: 25rem; } }
</style>
