---
import Layout from '../layouts/Layout.astro';
import transportData from '../data/transport-schedules.json';

const villarsRoutes = transportData.routes.filter((route) => route.schedules.some((schedule) => schedule.stations.some((station) => station.normalizedName === 'villars')));
const initialRoute = villarsRoutes[0];
const initialDirections = initialRoute ? [...new Set(initialRoute.schedules.map((schedule) => schedule.direction))] : [];
const initialDirection = initialDirections[0];
const initialSchedule = initialRoute?.schedules.find((schedule) => schedule.day.key === 'weekday' && schedule.direction === initialDirection);
const initialStation = initialSchedule?.stations.find((station) => station.normalizedName === 'villars');
const formatTime = (minutes: number) => {
  const clock = minutes % 1440;
  return { value: `${String(Math.floor(clock / 60)).padStart(2, '0')}:${String(clock % 60).padStart(2, '0')}`, nextDay: minutes >= 1440 };
};
const updatedAt = transportData.source.updatedAt
  ? new Date(transportData.source.updatedAt).toLocaleString('es-AR', { timeZone: transportData.timezone, dateStyle: 'long', timeStyle: 'short' })
  : 'sin fecha informada';
---

<Layout title="Transporte en Villars" description="Horarios programados de colectivos y trenes con parada en Villars, obtenidos de SolarisPKN Transport." canonical="/transporte/">
  <section class="transport-page" data-transport-app>
    <header class="transport-hero">
      <p class="eyebrow">Datos abiertos · actualización diaria</p>
      <h1>Transporte en Villars</h1>
      <p>Consultá las salidas programadas de colectivos y trenes que pasan por Villars. No son datos en tiempo real: confirmá demoras o cambios con la empresa operadora.</p>
    </header>
    {villarsRoutes.length === 0 ? (
      <div class="transport-panel"><h2>Datos temporalmente no disponibles</h2><p>El snapshot actual no contiene recorridos con parada en Villars.</p></div>
    ) : (
      <div class="transport-panel">
        <div class="transport-controls">
          <label>Servicio<select data-route-select>{villarsRoutes.map((route) => <option value={route.id}>{route.type === 'bus' ? '🚌' : '🚆'} {route.branch || route.name}</option>)}</select></label>
          <label>Día<select data-day-select><option value="weekday">Lunes a viernes</option><option value="saturday">Sábado</option><option value="sunday">Domingo</option></select></label>
          <label>Sentido<select data-direction-select>{initialDirections.map((direction) => <option value={direction}>Hacia {direction}</option>)}</select></label>
        </div>
        <div class="next-service" aria-live="polite">
          <span class="next-label">Próximo servicio programado por Villars</span><strong data-next-service>Calculando…</strong><span data-next-detail>El cálculo usa la hora de Buenos Aires.</span>
        </div>
        <div class="schedule-heading">
          <div><p class="eyebrow" data-route-type>{initialRoute?.type === 'bus' ? 'Colectivo' : 'Tren'}</p><h2 data-schedule-title>Salidas desde Villars hacia {initialDirection}</h2></div>
          <p data-validity>{initialRoute?.validFrom ? `Vigencia informada desde ${new Date(`${initialRoute.validFrom}T12:00:00`).toLocaleDateString('es-AR')}` : 'Sin vigencia informada'}</p>
        </div>
        <div class="time-grid" data-time-grid aria-live="polite">
          {initialStation?.times.map((minutes) => { const time = formatTime(minutes); return <span class="time-chip">{time.value}{time.nextDay && <small>+1 día</small>}</span>; })}
        </div>
        <p class="empty-schedule" data-empty-schedule hidden={Boolean(initialStation?.times.length)}>No hay horarios cargados para esta combinación.</p>
        <div class="route-meta">
          <p><strong>Operador:</strong> <span data-company>{initialRoute?.company || 'No informado'}</span></p><p><strong>Método de actualización:</strong> <span data-update-method>{initialSchedule?.updateMethod || 'No informado'}</span></p>
          <p><a data-operator-link href={initialRoute?.websiteUrl || initialRoute?.sourceUrl || transportData.source.repository} target="_blank" rel="noopener noreferrer">Consultar fuente del operador</a></p>
        </div>
      </div>
    )}
    <aside class="data-note">
      <h2>Sobre estos datos</h2>
      <p>Snapshot actualizado el <strong>{updatedAt}</strong>. La copia SQLite y el JSON derivado quedan versionados para poder auditar cada cambio.</p>
      <p>Fuente: <a href={transportData.source.repository}>SolarisPKN Transport</a>. Hash del snapshot: <code>{transportData.source.databaseSha256.slice(0, 12)}…</code></p>
    </aside>
  </section>
  {villarsRoutes.length > 0 && <script>import '../scripts/transport.js';</script>}
</Layout>

<style>
  .transport-page { width: min(1100px, calc(100% - 2rem)); margin: 3rem auto; }
  .transport-hero { max-width: 760px; margin-bottom: 2rem; }
  .transport-hero h1 { margin: .25rem 0 1rem; color: var(--accent-mustard); font-family: Georgia, serif; font-size: clamp(2.3rem, 7vw, 4.5rem); }
  .transport-hero > p:last-child { color: var(--text-muted); font-size: 1.08rem; }
  .eyebrow { margin: 0; color: var(--accent-olive); font-family: 'JetBrains Mono', monospace; font-size: .78rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
  .transport-panel, .data-note { padding: clamp(1rem, 3vw, 2rem); border: 1px solid rgba(212,163,115,.35); border-radius: 1.5rem; background: rgba(44,33,25,.82); box-shadow: 0 20px 60px rgba(0,0,0,.25); }
  .transport-controls { display: grid; grid-template-columns: repeat(3, minmax(0,1fr)); gap: 1rem; }
  label { display: grid; gap: .4rem; color: var(--text-muted); font-size: .85rem; font-weight: 650; }
  select { width: 100%; padding: .72rem 2.2rem .72rem .8rem; border: 1px solid rgba(212,163,115,.52); border-radius: .75rem; color: var(--text-light); background: var(--bg-dark); }
  .next-service { display: grid; grid-template-columns: 1fr auto; gap: .15rem 1rem; align-items: center; margin: 1.5rem 0; padding: 1rem 1.15rem; border-left: 4px solid var(--accent-olive); border-radius: .8rem; background: rgba(163,177,138,.1); }
  .next-service strong { grid-column: 2; grid-row: 1 / span 2; color: var(--accent-mustard); font-size: clamp(1.4rem,4vw,2.2rem); }
  .next-service > span:last-child { color: var(--text-muted); font-size: .9rem; }
  .schedule-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: end; margin-top: 2rem; }
  .schedule-heading h2 { margin: .25rem 0 0; }.schedule-heading > p { color: var(--text-muted); font-size: .85rem; text-align: right; }
  .time-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(7.25rem,1fr)); gap: .65rem; margin-top: 1rem; }
  :global(.time-chip) { display: grid; place-items: center; min-height: 3.8rem; padding: .55rem; border: 1px solid rgba(233,196,106,.25); border-radius: .8rem; background: rgba(26,20,16,.75); color: var(--text-light); font-family: 'JetBrains Mono', monospace; font-size: 1.1rem; }
  :global(.time-chip small) { color: var(--accent-terracotta); font-family: Inter, sans-serif; font-size: .68rem; }
  .route-meta { display: flex; gap: .75rem 1.5rem; flex-wrap: wrap; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid rgba(212,163,115,.2); color: var(--text-muted); font-size: .85rem; }
  .route-meta p { margin: 0; }.data-note { margin-top: 1.25rem; background: rgba(44,33,25,.5); }
  .data-note h2 { font-size: 1.15rem; }.data-note p { margin: .4rem 0; color: var(--text-muted); font-size: .9rem; }.data-note code { word-break: break-all; }.empty-schedule { color: var(--text-muted); }
  @media (max-width: 720px) { .transport-controls { grid-template-columns: 1fr; } .next-service { grid-template-columns: 1fr; } .next-service strong { grid-column: 1; grid-row: auto; } .schedule-heading { align-items: start; flex-direction: column; } .schedule-heading > p { text-align: left; } }
</style>
