---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import t from '../locales/salud.json';

const actualizaciones = await getCollection('actualizaciones');
actualizaciones.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const updates = await Promise.all(actualizaciones.map(async (item) => {
  const { Content } = await render(item);
  return {
    fecha: item.data.fecha,
    titulo: item.data.titulo,
    Content,
  };
}));
---

<Layout title={t.titulo}>
  <div class="salud-container">
    <h1>{t.titulo}</h1>
    <p>{t.subtitulo}</p>

    <!-- Información fija -->
    <div class="salud-info glass">
      <h2>🚨 Emergencias</h2>
      <p>Ante una emergencia, llamá al <a href="tel:911"><strong>911</strong></a>.</p>
      <p><strong>Importante:</strong> los demás datos sanitarios están pendientes de verificación con una fuente oficial y no se publican como información vigente.</p>
    </div>

    <!-- Sección de actualizaciones -->
    <div class="actualizaciones-section">
      <h2>📢 Últimas actualizaciones</h2>
      <div id="updates-container">
        {updates.length === 0 ? (
          <p>No hay actualizaciones aún.</p>
        ) : updates.map(({ fecha, titulo, Content }, index) => (
          <article class="update-item" data-update-index={index}>
            <h3>{titulo}</h3>
            <time datetime={fecha.toISOString()}>
              {fecha.toLocaleDateString('es-AR', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            <Content />
          </article>
        ))}
      </div>
      <div id="pagination-controls" style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1rem;"></div>
    </div>
  </div>
</Layout>

<style>
  /* tus estilos */
</style>

<script>
  import '../scripts/health.js';
</script>
