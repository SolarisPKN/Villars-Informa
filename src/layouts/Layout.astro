---
import SEO from '@components/SEO.astro';
import type { BreadcrumbItem, ListingItem, SchemaType } from '@components/SEO.astro';
import { ClientRouter } from 'astro:transitions';
import '@styles/global.css';
import common from '../locales/common.json';

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  schema?: SchemaType;
  publishedTime?: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
  section?: string;
  wordCount?: number;
  business?: Record<string, unknown>;
  breadcrumbs?: BreadcrumbItem[];
  items?: ListingItem[];
  noindex?: boolean;
}

const {
  title,
  description = 'Noticias, historia, comercios, transporte e información útil de Villars.',
  image = '/social.jpg',
  canonical = Astro.url.pathname,
  schema = 'website',
  publishedTime,
  modifiedTime,
  author,
  tags = [],
  section,
  wordCount,
  business,
  breadcrumbs = [],
  items = [],
  noindex = false,
} = Astro.props;

const pathname = Astro.url.pathname;
const navItems = [
  { href: '/', label: common.nav.inicio },
  { href: '/noticias/', label: common.nav.noticias },
  { href: '/locales/', label: common.nav.locales },
  { href: '/transporte/', label: common.nav.transporte },
  { href: '/salud/', label: common.nav.salud },
];
const isActive = (href: string) => href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href);
---

<!doctype html>
<html lang="es-AR">
  <head>
    <SEO
      title={title}
      description={description}
      image={image}
      canonical={canonical}
      schema={schema}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      author={author}
      tags={tags}
      section={section}
      wordCount={wordCount}
      business={business}
      breadcrumbs={breadcrumbs}
      items={items}
      noindex={noindex}
    />
    <ClientRouter />
    <link rel="preload" href="/fonts/inter.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/jetbrains-mono.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <header class="site-header glass-pueblo">
      <a class="site-brand" href="/" aria-label="Villars Informa, inicio">
        <img src="/favicon.svg" alt="" width="30" height="30" loading="eager" fetchpriority="high" />
        <span>Villars Informa</span>
      </a>
      <nav class="site-nav" aria-label="Navegación principal">
        {navItems.map(({ href, label }) => (
          <a href={href} aria-current={isActive(href) ? 'page' : undefined}>{label}</a>
        ))}
        <a class="contact-link" href="https://labs.solarispkn.com.ar/es/portfolio/" rel="noopener noreferrer">{common.nav.contacto}</a>
      </nav>
    </header>
    <main id="main-content"><slot /></main>
    <footer class="site-footer glass-pueblo">
      <p>
        <span>{common.footer.transparente}</span>
        <a href="https://github.com/SolarisPKN/Villars-Informa" rel="noopener noreferrer">{common.footer.codigoAbierto}</a>
        <span aria-hidden="true"> — </span>
        <span>{common.footer.estado}</span>
      </p>
    </footer>
    <script>import '@scripts/scroll-animations.js';</script>
  </body>
</html>
