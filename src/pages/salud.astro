---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import salud from '../locales/salud.json';
import '../styles/health.css';

type Phone = { etiqueta?: string; numero?: string };
const actualizaciones = await getCollection('actualizaciones');
actualizaciones.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const updates = actualizaciones.slice(0, 5);
const formatDate = (date: Date) => date.toLocaleDateString('es-AR', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const validPhones = (phones: Phone[] = []) => phones.filter((phone) => phone.numero?.trim());
const phoneHref = (number: string) => 'tel:' + number.replace(/[^0-9+]/g, '');
const valueOrPending = (value: string) => value.trim() || salud.textos.datoPendiente;
---

<Layout
  title={salud.titulo}
  description={salud.descripcionSeo}
  canonical="/salud/"
>
  <div class="health-page">
    <header class="health-hero">
      <p class="health-kicker">Información comunitaria</p>
      <h1>{salud.titulo}</h1>
      <p>{salud.subtitulo}</p>
      {salud.verificadoEl && (
        <p class="health-verified">
          Datos fijos revisados el
          <time datetime={salud.verificadoEl}>{formatDate(new Date(salud.verificadoEl + 'T12:00:00'))}</time>.
        </p>
      )}
    </header>

    <section class="health-section updates-section" aria-labelledby="updates-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">{salud.actualizaciones.seccion}</p>
          <h2 id="updates-title">{salud.actualizaciones.titulo}</h2>
        </div>
        <span class="section-limit">{salud.textos.maximoAvisos}</span>
      </div>

      <div class="health-feed">
        {updates.length === 0 ? (
          <div class="health-empty">
            <span aria-hidden="true">✦</span>
            <p>{salud.actualizaciones.sinActualizaciones}</p>
          </div>
        ) : updates.map((update) => (
          <article class="health-update">
            <header>
              <span class="update-avatar" aria-hidden="true">+</span>
              <div>
                <h3>{update.data.titulo}</h3>
                <time datetime={update.data.fecha.toISOString()}>{formatDate(update.data.fecha)}</time>
              </div>
            </header>
            <p class="update-message">{update.data.mensaje}</p>
            {update.data.imagen && (
              <button
                class="update-image-button"
                type="button"
                data-health-image={update.data.imagen}
                data-health-alt={'Imagen adjunta de ' + update.data.titulo}
                aria-label={'Ampliar imagen de ' + update.data.titulo}
              >
                <img src={update.data.imagen} alt="" loading="lazy" />
              </button>
            )}
            {(update.data.fuente || update.data.fuenteUrl) && (
              <footer>
                <span>{salud.textos.fuente}</span>
                {update.data.fuenteUrl ? (
                  <a href={update.data.fuenteUrl} target="_blank" rel="noopener noreferrer">
                    {update.data.fuente || 'Ver publicación original'}
                  </a>
                ) : (
                  <span>{update.data.fuente}</span>
                )}
              </footer>
            )}
          </article>
        ))}
      </div>
    </section>

    <section class="health-section" aria-labelledby="villars-care-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">{salud.atencion.seccion}</p>
          <h2 id="villars-care-title">{salud.atencion.titulo}</h2>
        </div>
      </div>

      <div class="primary-services">
        {salud.atencion.serviciosPrincipales.map((service) => {
          const phones = validPhones(service.telefonos);
          return (
            <article class:list={['service-card', service.destacado && 'service-card-primary']}>
              <p class="service-kind">{service.tipo}</p>
              <h3>{service.nombre}</h3>
              <dl>
                <div><dt>Dirección</dt><dd class:list={{ 'pending-data': !service.direccion }}>{valueOrPending(service.direccion)}</dd></div>
                <div><dt>Horario</dt><dd class:list={{ 'pending-data': !service.horarios }}>{valueOrPending(service.horarios)}</dd></div>
                <div>
                  <dt>Teléfono</dt>
                  <dd>
                    {phones.length > 0 ? (
                      <ul class="phone-list">
                        {phones.map((phone) => (
                          <li>
                            <a href={phoneHref(phone.numero || '')}>{phone.etiqueta ? phone.etiqueta + ': ' : ''}{phone.numero}</a>
                          </li>
                        ))}
                      </ul>
                    ) : <span class="pending-data">{salud.textos.telefonoPendiente}</span>}
                  </dd>
                </div>
              </dl>
              {service.destino
                ? <a class="card-action" href={service.destino}>{service.estado} ↓</a>
                : <span class="status-chip">{service.estado}</span>}
            </article>
          );
        })}
      </div>

      <details class="more-centers">
        <summary>
          <span>{salud.atencion.mostrarOtros}</span>
          <small>{salud.atencion.resumenOtros}</small>
        </summary>
        <div class="center-grid">
          {salud.atencion.otrosCentros.map((center) => {
            const phones = validPhones(center.telefonos);
            return (
              <article class="center-card">
                <p>{center.localidad}</p>
                <h3>{center.nombre}</h3>
                <address class:list={{ 'pending-data': !center.direccion }}>{valueOrPending(center.direccion)}</address>
                <p class:list={{ 'pending-data': !center.horarios }}>{valueOrPending(center.horarios)}</p>
                {phones.length > 0 ? (
                  <ul class="phone-list phone-list-pills">
                    {phones.map((phone) => (
                      <li><a class="phone-link" href={phoneHref(phone.numero || '')}>{salud.textos.llamar}{phone.etiqueta ? ' · ' + phone.etiqueta : ''}: {phone.numero}</a></li>
                    ))}
                  </ul>
                ) : <span class="missing-contact">{salud.textos.telefonoPendiente}</span>}
              </article>
            );
          })}
        </div>
      </details>
    </section>

    <section id="farmacias" class="health-section pharmacies-section" aria-labelledby="pharmacies-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">{salud.farmacias.seccion}</p>
          <h2 id="pharmacies-title">{salud.farmacias.titulo}</h2>
        </div>
      </div>

      <div class="pharmacy-layout">
        <div class="pharmacy-selector">
          <label for="pharmacy-select">{salud.farmacias.selector}</label>
          <select id="pharmacy-select">
            {salud.farmacias.lista.map((pharmacy, index) => (
              <option value={index}>{pharmacy.nombre}</option>
            ))}
          </select>
          <p class="turn-warning">{salud.farmacias.advertencia}</p>
        </div>
        <div class="pharmacy-results" aria-live="polite">
          {salud.farmacias.lista.map((pharmacy, index) => {
            const phones = validPhones(pharmacy.telefonos);
            return (
              <article class="pharmacy-card" data-pharmacy-card={index} hidden={index !== 0}>
                <p class="service-kind">{pharmacy.localidad}</p>
                <h3>{pharmacy.nombre}</h3>
                <address class:list={{ 'pending-data': !pharmacy.direccion }}>{valueOrPending(pharmacy.direccion)}</address>
                <p class:list={{ 'pending-data': !pharmacy.horarios }}>{valueOrPending(pharmacy.horarios)}</p>
                {phones.length > 0 ? (
                  <ul class="phone-list phone-list-pills">
                    {phones.map((phone) => (
                      <li><a class="phone-link" href={phoneHref(phone.numero || '')}>{salud.textos.llamar}{phone.etiqueta ? ' · ' + phone.etiqueta : ''}: {phone.numero}</a></li>
                    ))}
                  </ul>
                ) : <span class="missing-contact">{salud.textos.telefonoPendiente}</span>}
              </article>
            );
          })}
        </div>
      </div>
    </section>

    <section class="health-section emergency-section" aria-labelledby="emergency-title">
      <div>
        <p class="section-kicker">{salud.urgencias.seccion}</p>
        <h2 id="emergency-title">{salud.urgencias.titulo}</h2>
        <p>{salud.urgencias.aviso}</p>
      </div>
      <div class="emergency-actions">
        {salud.urgencias.contactos.map((contact) => {
          const phones = validPhones(contact.telefonos);
          return (
            <article class="emergency-contact">
              <span>{contact.nombre}</span>
              {phones.length > 0 ? (
                <ul class="phone-list">
                  {phones.map((phone) => (
                    <li><a href={phoneHref(phone.numero || '')}><strong>{phone.numero}</strong>{phone.etiqueta && <small>{phone.etiqueta}</small>}</a></li>
                  ))}
                </ul>
              ) : <strong class="pending-data">{salud.textos.telefonoPendiente}</strong>}
            </article>
          );
        })}
      </div>
    </section>

    <details class="sources-panel">
      <summary>{salud.fuentes.titulo}</summary>
      <p>{salud.fuentes.aviso}</p>
      <ul>
        {salud.fuentes.lista.map((source) => (
          <li><a href={source.url} target="_blank" rel="noopener noreferrer">{source.etiqueta}</a></li>
        ))}
      </ul>
    </details>
  </div>

  <dialog id="health-image-dialog" class="image-dialog">
    <button type="button" data-dialog-close aria-label="Cerrar imagen">×</button>
    <img src="" alt="" />
  </dialog>

  <script>
    import '../scripts/health.js';
  </script>
</Layout>
