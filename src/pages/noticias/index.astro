---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { argentinaDateKey, eventBucket } from '../../utils/events.js';
import '../../styles/blog.css';

const noticias = await getCollection('noticias');
noticias.sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
const publicaciones = noticias.filter(({ data }) => !data.evento);
const eventos = noticias.filter(({ data }) => data.evento && data.fechaEvento);
const todayKey = argentinaDateKey();
const upcomingEvents = eventos
  .filter(({ data }) => eventBucket({ start: data.fechaEvento, end: data.fechaFinEvento }, todayKey) === 'upcoming')
  .sort((a, b) => a.data.fechaEvento.getTime() - b.data.fechaEvento.getTime());
const pastEvents = eventos
  .filter(({ data }) => eventBucket({ start: data.fechaEvento, end: data.fechaFinEvento }, todayKey) === 'past')
  .sort((a, b) => b.data.fechaEvento.getTime() - a.data.fechaEvento.getTime());
const allTags = [...new Set(publicaciones.flatMap(({ data }) => data.tags || []))];
const destacadas = noticias.slice(0, 5);
const seoItems = noticias.map((noticia) => ({
  name: noticia.data.titulo,
  url: `/noticias/${noticia.id}/`,
  description: noticia.data.descripcion,
  image: noticia.data.portada,
  type: 'Article' as const,
}));
---

<Layout
  title="Noticias y eventos de Villars"
  description="Noticias, avisos, agenda y novedades de la comunidad de Villars, Buenos Aires."
  canonical="/noticias/"
  schema="collection"
  items={seoItems}
  breadcrumbs={[{ name: 'Inicio', url: '/' }, { name: 'Noticias', url: '/noticias/' }]}
>
  <div class="blog-container">
    <div class="blog-header">
      <h1>📰 Noticias</h1>
      <p>Mantenete al día de todo lo que pasa en Villars</p>
    </div>

    {eventos.length > 0 && (
      <section class="community-agenda" aria-labelledby="agenda-title">
        <header class="agenda-heading">
          <div><p>Agenda comunitaria</p><h2 id="agenda-title">📅 Próximos eventos</h2></div>
          <span>Se actualiza según la fecha de Argentina</span>
        </header>
        <div class="event-grid" data-event-list="upcoming">
          {upcomingEvents.map((evento) => (
            <a
              class="event-card"
              href={`/noticias/${evento.id}/`}
              data-event-card
              data-event-start={evento.data.fechaEvento.toISOString().slice(0, 10)}
              data-event-end={evento.data.fechaFinEvento?.toISOString().slice(0, 10) || ''}
            >
              <div class="event-calendar" aria-hidden="true">
                <strong>{evento.data.fechaEvento.toLocaleDateString('es-AR', { day: '2-digit', timeZone: 'UTC' })}</strong>
                <span>{evento.data.fechaEvento.toLocaleDateString('es-AR', { month: 'short', timeZone: 'UTC' }).replace('.', '')}</span>
              </div>
              <div>
                <p>Evento</p>
                <h3>{evento.data.titulo}</h3>
                {(evento.data.horaEvento || evento.data.lugarEvento) && <span>{[evento.data.horaEvento && `${evento.data.horaEvento} h`, evento.data.lugarEvento].filter(Boolean).join(' · ')}</span>}
              </div>
            </a>
          ))}
        </div>
        <p class="agenda-empty" data-event-empty="upcoming" hidden={upcomingEvents.length > 0}>No hay próximos eventos publicados por ahora.</p>
      </section>
    )}

    {noticias.length === 0 ? (
      <div class="empty-state"><p>📝 No hay noticias aún. ¡Sé el primero en publicar!</p></div>
    ) : (
      <div class="blog-layout">
        <div class="main-column">
          <div class="section-title-row"><div><p>Actualidad</p><h2>Noticias de la comunidad</h2></div></div>
          {publicaciones.length > 0 ? (
            <>
              <div class="tag-filters">
                <span class="label">🏷️</span>
                <button class="tag-filter active" data-tag="all" aria-pressed="true">Todos</button>
                {allTags.map((tag) => <button class="tag-filter" data-tag={tag} aria-pressed="false">#{tag}</button>)}
              </div>
              <div id="post-grid" class="post-grid">
                {publicaciones.map((noticia) => (
                  <a href={`/noticias/${noticia.id}/`} style="text-decoration: none; color: inherit; display: block;">
                    <div class="post-card glass" data-tags={noticia.data.tags.join(',')}>
                      {noticia.data.portada && <div class="card-image"><img src={noticia.data.portada} alt={noticia.data.titulo} loading="lazy" decoding="async" /></div>}
                      <div class="card-body">
                        <div class="card-tags">
                          {noticia.data.tags.slice(0, 3).map((tag) => <span class="tag">#{tag}</span>)}
                          {noticia.data.tags.length > 3 && <span class="tag" style="opacity:0.5;">+{noticia.data.tags.length - 3}</span>}
                        </div>
                        <h2 class="card-title">{noticia.data.titulo}</h2>
                        {noticia.data.descripcion && <p class="card-description">{noticia.data.descripcion}</p>}
                        <div class="card-date">{noticia.data.fecha.toLocaleDateString('es-AR', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
                      </div>
                    </div>
                  </a>
                ))}
              </div>
            </>
          ) : <p class="agenda-empty">La agenda tiene actividad, pero todavía no hay noticias comunes publicadas.</p>}
        </div>

        <aside class="blog-sidebar">
          <div class="sidebar-card">
            <h2>🔥 Destacadas</h2>
            <ul>
              {destacadas.map((noticia) => (
                <li>
                  <a href={`/noticias/${noticia.id}/`} class="popular-link">{noticia.data.titulo}</a>
                  <div class="popular-date">{noticia.data.fecha.toLocaleDateString('es-AR', { year: 'numeric', month: 'short', day: 'numeric' })}</div>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    )}

    {eventos.length > 0 && (
      <section class="community-agenda past-agenda" aria-labelledby="past-events-title">
        <header class="agenda-heading"><div><p>Archivo</p><h2 id="past-events-title">🕘 Eventos anteriores</h2></div></header>
        <div class="event-grid" data-event-list="past">
          {pastEvents.map((evento) => (
            <a
              class="event-card is-past"
              href={`/noticias/${evento.id}/`}
              data-event-card
              data-event-start={evento.data.fechaEvento.toISOString().slice(0, 10)}
              data-event-end={evento.data.fechaFinEvento?.toISOString().slice(0, 10) || ''}
            >
              <div class="event-calendar" aria-hidden="true">
                <strong>{evento.data.fechaEvento.toLocaleDateString('es-AR', { day: '2-digit', timeZone: 'UTC' })}</strong>
                <span>{evento.data.fechaEvento.toLocaleDateString('es-AR', { month: 'short', timeZone: 'UTC' }).replace('.', '')}</span>
              </div>
              <div><p>Evento finalizado</p><h3>{evento.data.titulo}</h3>{evento.data.lugarEvento && <span>{evento.data.lugarEvento}</span>}</div>
            </a>
          ))}
        </div>
        <p class="agenda-empty" data-event-empty="past" hidden={pastEvents.length > 0}>Los eventos terminados aparecerán acá un día después de finalizar.</p>
      </section>
    )}
  </div>

  <script>
    import '../../scripts/blog.js';
    import '../../scripts/events.js';
  </script>
</Layout>
